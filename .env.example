# Copy this file to .env and fill the value locally. Never commit the real token.
TUSHARE_TOKEN=

# Daily research/fundamentals and realtime execution quotes are selected separately.
MONEYMORE_MARKET_DATA_SOURCE=tushare
MONEYMORE_REALTIME_DATA_SOURCE=alphafeed
# Keep ALPHAFEED_API_KEY in state/private/alphafeed.env or process environment.
# Install the optional SDK: uv pip install --python .venv/Scripts/python.exe -e ".[alphafeed]"
